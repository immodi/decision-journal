# Copy to .env and fill in from Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Show the Google button. Requires the provider enabled and the site domain
# listed under Authentication → Settings → Authorised domains.
VITE_GOOGLE_SIGN_IN=true

# Point the client at `firebase emulators:start`. When enabled, also set
# VITE_FIREBASE_PROJECT_ID=demo-decision-journal so it matches the seed data.
VITE_USE_EMULATOR=false
